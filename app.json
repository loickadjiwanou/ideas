{
  "expo": {
    "name": "ideas",
    "slug": "ideas",
    "owner": "loickadjiwanou",
    "scheme": "ideas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/app.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icons/app.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/app.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/icons/app.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-audio"
    ]
  }
}
